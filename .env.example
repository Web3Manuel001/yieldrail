# Runtime
NODE_ENV=development
PORT=3000

# SQLite (relative to the repo root; created automatically)
DATABASE_PATH=./data/yieldrail.db
MIGRATIONS_DIR=./migrations

# Stellar testnet only — never mainnet, never real funds
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# HMAC secret for outbound webhooks (fill in locally; never commit .env)
WEBHOOK_SECRET=replace-me

{
  "name": "yieldrail",
  "version": "0.1.0",
  "private": true,
  "description": "B2B API middleware for regulated USD yield on Stellar (testnet)",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev:api": "pnpm --filter @yieldrail/api dev",
    "start:api": "pnpm --filter @yieldrail/api start",
    "fund:accounts": "pnpm --filter @yieldrail/scripts fund-accounts"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
